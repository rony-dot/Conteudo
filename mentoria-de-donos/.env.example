# ------------------------------------------------------------------
# Mentoria de Donos — variáveis de ambiente
# Copie para .env.local e preencha. Sem elas o app sobe, mas cadastro
# e pagamento reais não funcionam.
# ------------------------------------------------------------------

# URL pública do site (usada em callbacks de pagamento e e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Chave service-role: SOMENTE server-side (webhook/rotas de API). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Mercado Pago (https://www.mercadopago.com.br/developers) ---
# Use as credenciais de TESTE (sandbox) para desenvolvimento.
# Credenciais da APLICAÇÃO (marketplace/plataforma):
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx

# Split de pagamento (OAuth do vendedor). Crie a aplicação em modo
# "Pagamentos divididos/Marketplace" e copie Client ID e Client Secret:
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Deve ser IGUAL ao redirect_uri cadastrado na aplicação do Mercado Pago:
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/api/mp/oauth/callback

# Taxa da plataforma por sessão, em % (padrão 15)
PLATFORM_FEE_PERCENT=15

# --- Resend (opcional, e-mails transacionais) https://resend.com ---
RESEND_API_KEY=
EMAIL_FROM="Mentoria de Donos <contato@mentoriadedonos.com.br>"
